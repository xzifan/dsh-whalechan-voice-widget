{
  "name": "dsh-voice-workbench",
  "version": "0.6.4",
  "type": "module",
  "description": "DSH whale voice companion: Qwen-Audio-Realtime brain with a swappable TTS voice layer",
  "license": "MIT",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./lib/client.js"
  },
  "files": [
    "src",
    "lib",
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "cordis.patch.yml"
  ],
  "keywords": [
    "dsh",
    "voice",
    "tts",
    "asr",
    "realtime",
    "whale",
    "companion",
    "minimax",
    "qwen",
    "plugin"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:web": "node --test web/src/lib/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=\"src/**/*.js\" --test-coverage-lines=96 --test-coverage-branches=83 --test-coverage-functions=92 test/*.test.js",
    "test:coverage:web": "node --test --experimental-test-coverage --test-coverage-include=\"web/src/**/*.js\" --test-coverage-lines=90 --test-coverage-branches=86 --test-coverage-functions=89 web/src/lib/*.test.js",
    "test:browser": "python3 test/browser-smoke.py",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "npm --prefix web run build",
    "pack:check": "npm pack --dry-run",
    "prepack": "npm run lint"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  }
}
