{
  "name": "dsh-voice-workbench",
  "version": "0.6.1",
  "type": "module",
  "description": "DSH whale voice companion: Qwen-Audio-Realtime brain with a swappable TTS voice layer",
  "license": "MIT",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./lib/client.js"
  },
  "files": [
    "src",
    "lib",
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "cordis.patch.yml"
  ],
  "keywords": [
    "dsh",
    "voice",
    "tts",
    "asr",
    "realtime",
    "whale",
    "companion",
    "minimax",
    "qwen",
    "plugin"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:web": "node --test web/src/lib/*.test.js",
    "test:browser": "python3 test/browser-smoke.py",
    "build": "npm --prefix web run build",
    "pack:check": "npm pack --dry-run"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
